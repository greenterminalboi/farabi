DATABASE_URL=postgres://farabi:farabi@127.0.0.1:5432/farabi
TEST_DATABASE_URL=postgres://farabi:farabi@127.0.0.1:5432/farabi_test
# "claude-code" uses your local Claude Code login (Claude subscription, personal use);
# "claude" uses the Claude API (needs ANTHROPIC_API_KEY); "fake" gives deterministic replies.
AI_PROVIDER=fake
# "reply" (default) refreshes a label after every reply; "map" waits until the map is opened.
SUMMARY_TRIGGER=reply
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5).
# CLAUDE_MODEL=claude-opus-5
# Where feedback screenshots and the generated FEEDBACK.md live (default: feedback/ at the repo root).
# FEEDBACK_DIR=feedback
